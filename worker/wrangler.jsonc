{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuget-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "NuGetContainer",
      "image": "docker.io/soenneker/cloudflare-nuget:latest",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INSPECTOR",
        "class_name": "NuGetContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NuGetContainer"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuget-metadata",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGES",
      "bucket_name": "nuget-packages"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://nuget.example.com"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "nuget.example.com",
      "custom_domain": true
    }
  ]
}
